@namespace FormFlow.App.Components
@inherits FormFlow.Components.FieldComponentBase

@* Example of a custom field component registered via AddCustomFieldType<DatePickerField>("date").
   Demonstrates that any Blazor component inheriting FieldComponentBase can be plugged in
   as a first-class field type without modifying FormFlow.Components. *@

<div class="mb-3">
    <label for="@_id" class="form-label">
        @Field.Label
        @if (Field.Required)
        {
            <span class="text-danger ms-1" aria-hidden="true">*</span>
        }
    </label>

    <input id="@_id"
           type="date"
           class="form-control @(ValidationErrors.Count > 0 ? "is-invalid" : "")"
           value="@_dateValue"
           placeholder="@Field.Placeholder"
           @onchange="HandleChange" />

    @foreach (var error in ValidationErrors)
    {
        <div class="invalid-feedback d-block">@error</div>
    }
</div>

@code {
    private string _id = string.Empty;
    private string _dateValue = string.Empty;

    protected override void OnParametersSet()
    {
        _id = $"field-{Field.Key.ToLowerInvariant()}";
        _dateValue = Value is string s ? s : string.Empty;
    }

    private async Task HandleChange(ChangeEventArgs e)
    {
        _dateValue = e.Value?.ToString() ?? string.Empty;
        await OnValueChanged.InvokeAsync(_dateValue == string.Empty ? null : _dateValue);
    }
}
