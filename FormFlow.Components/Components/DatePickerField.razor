@namespace FormFlow.Components
@inherits FieldComponentBase

<div class="mb-3">
    <label class="form-label" for="@_id">
        @Field.Label
        @if (Field.Required)
        {
            <span class="text-danger ms-1" title="Required">*</span>
        }
    </label>

    <input id="@_id"
           type="date"
           class="form-control @(HasErrors ? "is-invalid" : "")"
           value="@_dateValue"
           @onchange="HandleChange" />

    @if (HasErrors)
    {
        <div class="invalid-feedback d-block">
            @foreach (var e in ValidationErrors)
            {
                <div><i class="bi bi-exclamation-circle-fill me-1"></i>@e</div>
            }
        </div>
    }
</div>

@code {
    private string _id        = string.Empty;
    private string _dateValue = string.Empty;

    private bool HasErrors => ValidationErrors.Count > 0;

    protected override void OnInitialized() => _id = $"field-{Field.Key.ToLowerInvariant()}";

    protected override void OnParametersSet()
    {
        _dateValue = Value is string s ? s : string.Empty;
    }

    private async Task HandleChange(ChangeEventArgs e)
    {
        _dateValue = e.Value?.ToString() ?? string.Empty;
        await OnValueChanged.InvokeAsync(_dateValue == string.Empty ? null : _dateValue);
    }
}
